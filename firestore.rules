rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 120 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 180)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.preferredTheme in ['DARK', 'SYSTEM', 'LIGHT'] &&
             data.gridColumns is int &&
             data.gridColumns >= 2 &&
             data.gridColumns <= 5 &&
             data.gridViewMode in ['COMPACT', 'DETAILED'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCloudFavorite(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.mediaId is int &&
             data.mediaId >= 0 &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 260 &&
             data.mediaType in ['IMAGE', 'VIDEO'] &&
             data.bucketName is string &&
             data.bucketName.size() <= 120 &&
             data.sizeBytes is int &&
             data.sizeBytes >= 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAiCreationRecord(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.mode in ['VISION_COACH', 'IMAGE_STUDIO', 'ANIMATE_PHOTO', 'VOICE_AUDIO'] &&
             data.modelId is string &&
             data.modelId.size() >= 1 &&
             data.modelId.size() <= 80 &&
             data.prompt is string &&
             data.prompt.size() >= 1 &&
             data.prompt.size() <= 1000 &&
             data.outputSummary is string &&
             data.outputSummary.size() >= 1 &&
             data.outputSummary.size() <= 1500 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'preferredTheme',
                         'gridColumns', 'gridViewMode', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'email', 'photoUrl',
                         'preferredTheme', 'gridColumns', 'gridViewMode',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'email', 'photoUrl',
                         'preferredTheme', 'gridColumns', 'gridViewMode', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /favorites/{favoriteId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(favoriteId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(favoriteId) &&
                         incoming().keys().hasAll([
                           'userId', 'mediaId', 'displayName', 'mediaType',
                           'bucketName', 'sizeBytes', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'mediaId', 'displayName', 'mediaType',
                           'bucketName', 'sizeBytes', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidCloudFavorite(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(favoriteId) &&
                         isValidCloudFavorite(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().mediaId == existing().mediaId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'displayName', 'mediaType', 'bucketName', 'sizeBytes', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(favoriteId);
      }

      match /aiCreations/{creationId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(creationId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(creationId) &&
                         incoming().keys().hasAll([
                           'userId', 'mode', 'modelId', 'prompt',
                           'outputSummary', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'mode', 'modelId', 'prompt',
                           'outputSummary', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidAiCreationRecord(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(creationId) &&
                         isValidAiCreationRecord(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'mode', 'modelId', 'prompt', 'outputSummary', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(creationId);
      }
    }
  }
}
